# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tn_energy_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tn_energy_management

# JWT Authentication Secret
JWT_SECRET=tn_cloud_energy_jwt_secret_key_change_in_production_2026

# JWT Expiry
JWT_EXPIRES_IN=7d

# Python Executable Path (for XGBoost model execution)
PYTHON_PATH=python

# Allowed Frontend Origins (CORS)
FRONTEND_URL=*
